MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doc-to-dashboard?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
CLIENT_URL=http://localhost:5173

# AI provider routing: openrouter, openai, groq, or gemini
AI_PRIMARY_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=groq
AI_REQUEST_TIMEOUT_MS=45000
AI_RETRIES=1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional semantic retrieval: openai, openrouter, or gemini (uses that provider's API key above).
# Leave empty to use lexical BM25 retrieval only.
AI_EMBEDDINGS_PROVIDER=
AI_EMBEDDINGS_MODEL=

# Agent pipeline switches and per-user guardrails
AI_PLANNER=on
AI_VERIFIER=on
AI_USER_DAILY_TOKEN_BUDGET=
UPLOAD_JOB_CONCURRENCY=2
REQUEST_LOGGING=on
TRUST_PROXY_HOPS=0

# Optional: ping an HTTP(S) health URL every 10 minutes (minimum 5 minutes).
# An external monitor is more reliable for waking a sleeping deployment.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=600000
